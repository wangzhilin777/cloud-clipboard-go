<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/floating_confirm_card_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/floating_confirm_badge_background"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/clipboard_ime_badge"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:textColor="@color/cc_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/imeStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/floating_confirm_badge_background"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/clipboard_ime_idle"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:textColor="@color/cc_text_muted"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/imeTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/clipboard_ime_title"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
        android:textColor="@color/cc_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/imeSubtitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/clipboard_ime_subtitle"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
        android:textColor="@color/cc_text_muted" />

    <TextView
        android:id="@+id/imeActionHintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/clipboard_ime_action_hint"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
        android:textColor="@color/cc_text_muted" />

    <TextView
        android:id="@+id/imePreviewText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/content_panel_background"
        android:maxLines="4"
        android:padding="14dp"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
        android:textColor="@color/cc_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/imeSendButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/floating_confirm_primary_button_background"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/clipboard_ime_send_button"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/imeOpenAppButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/floating_confirm_secondary_button_background"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/clipboard_ime_open_app_button"
            android:textColor="@color/cc_primary" />
    </LinearLayout>
</LinearLayout>
